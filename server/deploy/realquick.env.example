# /etc/realquick/gateway.env — read by realquick-gateway.service.
# deploy.sh --key writes the real file from app-builder/.env; never commit it.
PORT=8096
PROVIDER=anthropic            # anthropic | perplexity | fake
MODEL=claude-opus-5-5         # see README → "Picking the model" (Haiku 5.5 is ~40x cheaper)
EFFORT=low
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
FREE_PER_DAY=3
PRO_PER_DAY=60
FREE_PER_IP=15
STATE_FILE=/var/lib/realquick/usage.json
# GOOGLE_SERVICE_ACCOUNT_FILE=/etc/realquick/play-service-account.json
