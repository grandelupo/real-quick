# /etc/realquick/gateway.env — read by realquick-gateway.service.
# deploy.sh --key writes the real file from app-builder/.env; never commit it.
# systemd keeps everything after "=" (inline comments included), so comments
# go on their own lines.
PORT=8099
# anthropic | perplexity | fake
PROVIDER=anthropic
# see README → "Picking the model" (Haiku 5.5 is ~40x cheaper)
MODEL=claude-opus-5-5
EFFORT=low
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
# free counts per day during the free window, then the window itself
FREE_PER_DAY=12
TRIAL_DAYS=3
PRO_PER_DAY=60
FREE_PER_IP=15
STATE_FILE=/var/lib/realquick/usage.json
# installs.json and shares.json live next to it
SHARE_BASE=https://realquick.lab.karolkrakowski.pl
# GOOGLE_SERVICE_ACCOUNT_FILE=/etc/realquick/play-service-account.json
